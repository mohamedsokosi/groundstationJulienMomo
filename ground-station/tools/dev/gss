#!/bin/bash
# gss, Ground Station convenience CLI.
# Wraps tools/dev/start-local.sh and the dev logs. Run `gss help` for the list.
# (Named `gss`, not `gs`, because `gs` is Ghostscript.)

# Resolve our real location (this file is usually symlinked into ~/.local/bin),
# so we can find start-local.sh next to it regardless of where it's invoked.
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT")"
START="$SCRIPT_DIR/start-local.sh"

DEFAULT_IP="10.180.97.23"
BACKEND_PORT="${GS_BACKEND_PORT:-5000}"
FRONTEND_PORT="${GS_FRONTEND_PORT:-5173}"
LOG_DIR="${GS_LOG_DIR:-$HOME/Desktop/ground-station-logs}"
BACKEND_LOG="$LOG_DIR/ground-station-backend.txt"
FRONTEND_LOG="$LOG_DIR/ground-station-frontend.txt"

resolve_ip() {
    local arg="${1:-}"
    if [[ -z "$arg" || "$arg" == "defaut" || "$arg" == "default" ]]; then
        echo "$DEFAULT_IP"
    else
        echo "$arg"
    fi
}

cmd_start() {
    local ip; ip="$(resolve_ip "${1:-}")"
    echo "DÉMARRAGE, CLOUD ON, BROKER $ip"
    bash "$START" -Restart -BrokerHost "$ip"
}

cmd_startoffline() {
    local ip; ip="$(resolve_ip "${1:-}")"
    echo "DÉMARRAGE HORS-LIGNE, PAS D'UPLOAD CLOUD, BROKER $ip"
    bash "$START" -Restart -Offline -BrokerHost "$ip"
}

cmd_simulation() {
    # Rejoue le CSV de vol canonique ICARUS2 comme si c'était de la télémétrie
    # live : broker MQTT local + simulateur -> même pipeline que le vrai matériel,
    # sans matériel. Offline (pas d'upload cloud) et sans capture CSV locale, pour
    # ne pas polluer l'archive Google Sheet / ~/Desktop/telemetry avec du simulé.
    local default_csv csv
    default_csv="$(cd "$SCRIPT_DIR/../../.." && pwd)/Safari_GS_antenna/telemetrySender/src/telemetry.csv"
    csv="${1:-$default_csv}"
    if [[ ! -f "$csv" ]]; then
        echo "CSV de simulation introuvable: $csv" >&2
        echo "Usage: gss simulation [chemin/vers/telemetry.csv]" >&2
        return 1
    fi
    if ! command -v mosquitto >/dev/null 2>&1; then
        echo "mosquitto (broker MQTT local) manquant — requis pour la simulation." >&2
        echo "Installe-le puis relance :  sudo apt install -y mosquitto" >&2
        return 1
    fi
    echo "SIMULATION — BROKER LOCAL + REJEU CSV (offline, sans capture CSV locale)"
    echo "CSV: $csv"
    TELEMETRY_CSV_LOG_ENABLED=0 bash "$START" -Restart -Mqtt -Simulator -Offline -SimCsv "$csv"
}

cmd_kill() {
    local found=0 port pid pids
    echo "ARRÊT DE LA GROUND STATION"
    for port in "$BACKEND_PORT" "$FRONTEND_PORT"; do
        pids="$(lsof -ti "tcp:$port" -sTCP:LISTEN 2>/dev/null || true)"
        for pid in $pids; do
            echo "kill PID $pid (port $port)"
            kill "$pid" 2>/dev/null || true
            found=1
        done
    done
    # The CubeSat simulator is an MQTT publisher with no listening port, so the
    # port loop above misses it. Kill it by name too, or it keeps publishing.
    if pgrep -f "mqtt_cubesat_simulator.py" >/dev/null 2>&1; then
        echo "kill simulateur CubeSat"
        pkill -f "mqtt_cubesat_simulator.py" 2>/dev/null || true
        found=1
    fi
    if [[ $found -eq 0 ]]; then
        echo "Rien à arrêter (aucun process sur $BACKEND_PORT / $FRONTEND_PORT)."
    else
        echo "Ground station arrêtée."
    fi
}

cmd_verbose() {
    # Default: backend only (the frontend/vite log is mostly build noise).
    # `gss verbose all` → backend + frontend ; `gss verbose front` → frontend only.
    case "${1:-back}" in
        all|both)
            if ! ls "$LOG_DIR"/*.txt >/dev/null 2>&1; then
                echo "Pas encore de logs ($LOG_DIR). Lance 'gss start' d'abord."; return 1
            fi
            echo "LOGS BACKEND + FRONTEND, CTRL+C POUR QUITTER"
            tail -n 40 -f "$LOG_DIR"/*.txt
            ;;
        front|frontend)
            [[ -f "$FRONTEND_LOG" ]] || { echo "Log frontend absent. Lance 'gss start' d'abord."; return 1; }
            echo "LOG FRONTEND EN DIRECT, CTRL+C POUR QUITTER"
            tail -n 40 -f "$FRONTEND_LOG"
            ;;
        *)
            [[ -f "$BACKEND_LOG" ]] || { echo "Log backend absent. Lance 'gss start' d'abord."; return 1; }
            echo "LOG BACKEND EN DIRECT, CTRL+C POUR QUITTER"
            tail -n 40 -f "$BACKEND_LOG"
            ;;
    esac
}

cmd_debug() {
    if [[ ! -f "$BACKEND_LOG" ]]; then
        echo "Pas de log backend ($BACKEND_LOG). Lance 'gss start' d'abord."
        return 1
    fi
    echo "ERREURS / WARNINGS RÉCENTS (BACKEND) :"
    grep -iE "error|warn|exception|traceback|failed|critical" "$BACKEND_LOG" | tail -n 60 \
        || echo "(aucune erreur trouvée, tout va bien)"
}

cmd_help() {
    cat <<'EOF'
gss, Ground Station CLI

  gss start [ip]          Démarre la station (upload cloud activé).  Défaut: 10.180.97.23
  gss start defaut        Démarre avec l'IP par défaut (10.180.97.23)
  gss startoffline [ip]   Démarre SANS upload cloud (Google Sheet désactivé)
  gss simulation [csv]    Rejoue un CSV comme télémétrie live (broker local, offline)
  gss kill                Arrête la station (backend + frontend)
  gss verbose [all|front] Suit le log backend en direct (all = +frontend)
  gss debug               Affiche les erreurs / warnings récents
  gss help                Affiche cette aide

Exemples:
  gss start 10.180.97.45      # broker sur cette IP
  gss start defaut            # IP par défaut
  gss startoffline            # local seulement, pas de cloud
  gss simulation              # rejoue le CSV de vol ICARUS2 (sans matériel)
EOF
}

sub="${1:-help}"
shift 2>/dev/null
case "$sub" in
    start)              cmd_start "${1:-}";;
    startoffline)       cmd_startoffline "${1:-}";;
    simulation|sim|simulate) cmd_simulation "${1:-}";;
    kill|stop)          cmd_kill;;
    verbose|logs)       cmd_verbose "${1:-}";;
    debug|errors)       cmd_debug;;
    help|-h|--help|"")  cmd_help;;
    *) echo "Commande inconnue: '$sub'"; echo; cmd_help; exit 1;;
esac
